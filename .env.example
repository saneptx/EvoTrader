# Copy to .env in the repository root: cp .env.example .env
# Read by the application (load_settings, from the current working directory) and by docker compose.
# Process environment variables override values here. Placeholders only — never commit real secrets.
# v0.1 supports research mode only; any other value fails startup.
RUN_MODE=research

DATABASE_URL=postgresql+psycopg://evotrader:evotrader@127.0.0.1:5432/evotrader
REDIS_URL=redis://127.0.0.1:6379/0
ARTIFACT_ROOT=./artifacts

# Only the deterministic fake provider is supported until Weeks 2-3.
LLM_PROVIDER=fake
LLM_MODEL=fake-model-v0
# LLM_API_KEY=<optional, never logged>
MAX_LLM_CALLS=0
MAX_RESEARCH_COST_USD=0

# docker compose only (ignored by the application); local development credentials only
POSTGRES_USER=evotrader
POSTGRES_PASSWORD=evotrader
POSTGRES_DB=evotrader
POSTGRES_PORT=5432
REDIS_PORT=6379
